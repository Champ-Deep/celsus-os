{
  "name": "celsus-os",
  "type": "module",
  "description": "A knowledge base OS for a folder of markdown. Maps it as a graph, has a calibrated classifier judge every call, and turns what it is unsure about into one card at a time for a human to answer. It learns the answers and writes its own decision policy back into the folder.",
  "version": "0.2.0",
  "bin": {
    "celsus": "./bin/celsus"
  },
  "main": "./cli.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node cli.ts setup",
    "doctor": "node cli.ts doctor",
    "run": "node cli.ts run",
    "serve": "node cli.ts serve",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --module esnext --target es2022 --moduleResolution bundler --skipLibCheck *.ts"
  },
  "keywords": [
    "obsidian",
    "knowledge-graph",
    "second-brain",
    "knowledge-base",
    "jev",
    "typesafe",
    "openrouter",
    "local-llm",
    "ollama",
    "human-in-the-loop",
    "generative-ui"
  ],
  "files": [
    "*.ts",
    "bin",
    "ui",
    "docs",
    "install.sh",
    "README.md",
    "SECURITY.md",
    "TESTING.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Champ-Deep/celsus-os.git"
  },
  "homepage": "https://github.com/Champ-Deep/celsus-os",
  "bugs": {
    "url": "https://github.com/Champ-Deep/celsus-os/issues"
  },
  "dependencies": {},
  "devDependencies": {}
}
